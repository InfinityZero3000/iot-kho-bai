    {
        "id": "f6",
        "type": "function",
        "z": "tab1",
        "name": "xe nâng giả (nhường Wokwi)",
        "func": "if (flow.get('wokwiOn')) return null;  // Wokwi đang online -> không giả lập đè lên dữ liệu thật\n  // đóng vai ESP32: nhận kho/cmd/mode, mỗi 3s xe nâng giả đi A -> B -> C -> không có xe\n  if (msg.topic === 'kho/cmd/mode') flow.set('simMode', String(msg.payload));\n  else flow.set('pos', ((flow.get('pos') ?? -1) + 1) % 4);\n  const mode = flow.get('simMode') || 'auto', p = flow.get('pos') ?? 3;\n  const on = i => mode === 'on' ? 1 : mode === 'off' ? 0 : +(i === p);\n  return [[{ topic: 'kho/status', payload: 'online', retain: true }].concat(['A', 'B', 'C'].map((k, i) =>\n({ topic: 'kho/zone/' + k, payload: { pir: +(i === p), on: on(i) }, retain: true })))];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
