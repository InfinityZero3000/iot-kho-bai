    {
        "id": "f3",
        "type": "function",
        "z": "tab1",
        "name": "URL Blynk",
        "func": "const token = env.get('BLYNK_TOKEN');\n  if (!token) { node.status({ fill: 'red', shape: 'ring', text: 'thiếu BLYNK_TOKEN' }); return null; }\n  node.status({});\n  const s = flow.get('s') || {}, e = flow.get('e') || { used: 0, base: 0 };\n  const on = ['A', 'B', 'C'].map(k => (s[k] && s[k].on ? 1 : 0));\n  const pins = {\nV0: on[0], V1: on[1], V2: on[2], V3: s.online ? 1 : 0,\nV4: Math.round((3 - on[0] - on[1] - on[2]) / 3 * 100),\nV5: e.used.toFixed(3), V6: (e.base - e.used).toFixed(3)\n  };\n  msg.url = 'https://blynk.cloud/external/api/batch/update?token=' + token + '&' +\nObject.entries(pins).map(([k, v]) => k + '=' + v).join('&');\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
