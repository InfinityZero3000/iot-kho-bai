    {
        "id": "f2",
        "type": "function",
        "z": "tab1",
        "name": "tính điện năng",
        "func": "const s = flow.get('s') || {};\n  const now = Date.now();\n  const e = flow.get('e') || { used: 0, base: 0 };\n  // chi cong don khi ESP32 online va khoang cach hop ly (tranh cong don luc Node-RED tat)\n  if (e.t && s.online && now - e.t < 120000) {\nconst kwh = (now - e.t) / 3.6e9 * (Number(env.get('LAMP_W')) || 150); // kWh moi khu\ne.used += ['A', 'B', 'C'].filter(k => s[k] && s[k].on).length * kwh;\ne.base += 3 * kwh; // moc so sanh: ca 3 khu sang lien tuc\n  }\n  e.t = now;\n  flow.set('e', e);\n  const saved = e.base - e.used;\n  const pct = e.base ? Math.round(saved / e.base * 100) : 0;\n  return [{ payload: 'Dùng ' + e.used.toFixed(2) + ' kWh · tiết kiệm ' + saved.toFixed(2) + ' kWh (' + pct + '%)' }, {}];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 360,
        "wires": [
