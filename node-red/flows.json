        "z": "tab1",
        "name": "Wokwi -> kho/*",
        "func": "// Wokwi (HiveMQ, PREFIX huit-khobai-nht) -> topic kho/* mà cả flow đang dùng\n  const P = 'huit-khobai-nht', t = msg.topic, v = String(msg.payload);\n  if (t === P + '/trangthai') {\n    flow.set('wokwiOn', v === 'online');\n    return { topic: 'kho/status', payload: v, retain: true };\n  }\n  const m = t.match(/^huit-khobai-nht\\/khu([1-3])\\/(pir|den)$/);\n  if (!m) return null;\n  const w = flow.get('w') || {};\n  const z = w[m[1]] = w[m[1]] || { pir: 0, on: 0 };\n  if (m[2] === 'pir') z.pir = +(v === '1'); else z.on = +(v === 'ON');\n  flow.set('w', w);\n  return { topic: 'kho/zone/' + 'ABC'[m[1] - 1], payload: { pir: z.pir, on: z.on }, retain: true };",
        "outputs": 1,
