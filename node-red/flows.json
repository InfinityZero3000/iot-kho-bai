    {
        "id": "f1",
        "type": "function",
        "z": "tab1",
        "name": "cập nhật trạng thái",
        "func": "const t = msg.topic, p = msg.payload;\n  const s = flow.get('s') || { A: {}, B: {}, C: {} };\n  if (t === 'kho/status') s.online = String(p) === 'online';\n  else if (/^kho\\/zone\\/[ABC]$/.test(t)) s[t.slice(-1)] = (p && typeof p === 'object') ? p : {};\n  else return null;\n  flow.set('s', s);\n\n  const Z = [s.A, s.B, s.C];\n  const on = Z.filter(z => z.on).length;\n  const txt = z => s.online === false ? 'Không rõ' : z.on ? (z.pir ? 'SÁNG (có xe nâng)' : 'SÁNG (giữ đèn)') : 'Tắt';\n  const status = s.online === undefined ? 'Chờ ESP32...' : s.online ? 'ESP32 online' : 'ESP32 OFFLINE - mất kết nối';\n  return [{ payload: txt(Z[0]) }, { payload: txt(Z[1]) }, { payload: txt(Z[2]) },\n{ payload: Math.round((3 - on) / 3 * 100) }, { payload: on }, { payload: status }, {}];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 160,
        "wires": [
            [
                "tA"
            ],
            [
                "tB"
            ],
            [
                "tC"
            ],
            [
                "gauge"
            ],
